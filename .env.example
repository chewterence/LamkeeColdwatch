POSTGRES_USER=coldwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=coldwatch
INGEST_PORT=8000

# Address the ingest listens on. 0.0.0.0 = every network interface, so it keeps
# working when the Mac's IP changes. Set to a fixed LAN IP only to restrict it.
INGEST_BIND_IP=0.0.0.0
# Port the sensor server pushes UDP to
UDP_PORT=2049

# Notifier (Telegram). Create a bot with @BotFather and paste its token here.
# Leave both empty to run the notifier in log-only mode.
TELEGRAM_BOT_TOKEN=
# Run `docker compose run --rm notifier python -m app.chatid` after messaging the bot
TELEGRAM_CHAT_ID=
